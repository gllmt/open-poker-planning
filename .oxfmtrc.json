{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      ["value-builtin", "value-external", "type-builtin", "type-external"],
      [
        "value-internal",
        "type-internal",
        "value-parent",
        "type-parent",
        "value-sibling",
        "type-sibling",
        "value-index",
        "type-index"
      ],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "out/**",
    "coverage/**",
    "convex/_generated/**",
    "public/**",
    "**/*.config.*",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.svg",
    "LICENSE"
  ]
}
