  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "convex dev --start 'next dev'",
    "build": "next build",
    "build:vercel": "convex deploy --cmd 'pnpm build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "lint": "oxlint .",
    "lint:ui": "oxlint --config .oxlintrc.json app components",
    "test": "vitest run",
    "lints": "pnpm format:check && pnpm lint && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@posthog/next": "^0.9.0",
