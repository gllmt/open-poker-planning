{
  "name": "open-poker-planning",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "convex dev --start 'next dev'",
    "build": "next build",
    "build:vercel": "node scripts/check-convex-deployment.mjs && convex deploy --cmd 'pnpm build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "lint": "oxlint .",
    "lint:ui": "oxlint --config .oxlintrc.json app components",
    "test": "vitest run",
    "lints": "pnpm format:check && pnpm lint && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@posthog/next": "^0.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sileo": "^0.1.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.62",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
