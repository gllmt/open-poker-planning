# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional (public): enable timer debug presets (e.g. 10s)
NEXT_PUBLIC_TIMER_DEBUG=false

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional (server-only): global access gate for the whole site
# Set a long random value (treat it like a password).
SITE_ACCESS_CODE=YOUR_LONG_RANDOM_ACCESS_CODE

# Optional (server-only): Realtime broadcast channel idle TTL (ms)
# Defaults to 900000 (15 min) if unset or invalid.
REALTIME_CHANNEL_TTL_MS=900000

# Optional (server-only): absolute site URL for SEO metadata and sitemap
SITE_URL=https://your-domain.com
