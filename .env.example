# Public (exposed to the browser)
# Filled in .env.local by `pnpm exec convex dev`.
# NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Optional (public): enable timer debug presets (e.g. 10s)
NEXT_PUBLIC_TIMER_DEBUG=false

# Optional (public): enable PostHog analytics. Leave unset to disable.
# Analytics is optional and configured cookieless by default.
# Use https://eu.i.posthog.com for PostHog Cloud EU, or your own host if self-hosted.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional (public): enable self-hosted Umami analytics. Leave unset to disable.
# NEXT_PUBLIC_UMAMI_HOST=https://umami.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-public-website-id

# Server-only (never expose to the browser)
# Filled in .env.local by `pnpm exec convex dev`.
# CONVEX_DEPLOYMENT=YOUR_CONVEX_DEPLOYMENT

# Required (server-only): shared by Next.js and the Convex deployment.
# Generate at least 32 random characters and configure the exact same value in both.
# CONVEX_SERVICE_SECRET=YOUR_LONG_RANDOM_SERVICE_SECRET

# Optional (server-only): global access gate for the whole site. Leave unset to disable.
# Set a long random value (treat it like a password).
# SITE_ACCESS_CODE=YOUR_LONG_RANDOM_ACCESS_CODE

# Optional (server-only): absolute site URL for SEO metadata and sitemap
# SITE_URL=https://your-domain.com

# Optional (dev-only): comma-separated origins allowed to reach `next dev`.
ALLOWED_DEV_ORIGINS=
